{
  "name": "edith-navigation-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "npm run test:unit",
    "test:node": "node --experimental-strip-types --test tests/bubble-float.test.ts tests/bubble-highlights.test.ts tests/bubble-layout.test.ts tests/liquid-demo.test.ts tests/liquid-drag.test.ts tests/liquid-material.test.ts tests/move-site.test.mjs tests/site-icons.test.ts tests/templates.test.ts",
    "test:unit": "vitest run",
    "test:component": "vitest --project component",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@vercel/analytics": "^2.0.1",
    "@vitejs/plugin-react": "latest",
    "d3-hierarchy": "^3.1.2",
    "liquid-gooey": "0.2.1",
    "lucide-react": "latest",
    "matter-js": "^0.20.0",
    "motion": "^13.2.0",
    "poly-decomp": "^0.3.0",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/matter-js": "^0.20.2",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "jsdom": "^29.1.1",
    "typescript-eslint": "latest",
    "vitest": "^5.0.1"
  }
}
